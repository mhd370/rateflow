# Frontend (CRA) environment example
#
# Copy to `.env` (do not commit secrets).

# Backend base URL for auth + other API calls (optional in dev)
REACT_APP_API_BASE_URL=https://rateflowbackend2-sc62njq2.b4a.run

# AI Insights chat endpoint (recommended)
REACT_APP_AI_CHAT_ENDPOINT=https://rateflowbackend2-sc62njq2.b4a.run/api/market-chat

# Optional dev-only browser key mode (NOT recommended)
# REACT_APP_ALLOW_BROWSER_AI=false
# REACT_APP_OPENAI_API_KEY=
# REACT_APP_OPENAI_MODEL=gpt-4o-mini
# REACT_APP_OPENAI_BASE_URL=https://api.openai.com/v1
